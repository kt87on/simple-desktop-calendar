# 依赖（安装后自动生成，体积大且平台相关）
node_modules/

# 打包产物（electron-builder 生成）
dist/

# 历史打包产物（本地回退用，不提交）
dist_prev_*/

# 日志
*.log

# 测试残留（smoke-test.js 会在 cwd 建 _mock_userdata，失败/中断时可能残留）
_mock_userdata/

# WorkBuddy 本地数据
.workbuddy/

# 本地诊断产物（截图 / 探针脚本 / 中间 JSON，仅本机使用，不入库）
.tmp-diag/

# 临时脚本与清点输出（形如 _build_log.txt / .filelist.txt）
_*.txt
.filelist*.txt

# 系统/编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
