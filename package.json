{
  "name": "simple-desktop-calendar",
  "version": "2.2.0",
  "description": "简洁桌面日历：极简 Windows 桌面日历，核心只做一件事——看日历、看放假、看上班。",
  "author": "YG",
  "homepage": "https://github.com/kt87on/simple-desktop-calendar",
  "repository": {
    "type": "git",
    "url": "https://github.com/kt87on/simple-desktop-calendar.git"
  },
  "license": "MIT",
  "main": "electron-main.js",
  "scripts": {
    "dev": "electron .",
    "verify": "node verify_v1721.js",
    "smoke": "node smoke-test.js",
    "runtime": "node runtime-test_v1721.js",
    "asar": "node verify_asar_v1721.js",
    "check": "node verify_v1721.js && node smoke-test.js && node runtime-test_v1721.js",
    "prebuild": "node verify_v1721.js && node smoke-test.js && node runtime-test_v1721.js",
    "build": "node make-icon.js && node build.js && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.yg.simplecalendar",
    "productName": "简洁桌面日历",
    "executableName": "SimpleCalendar",
    "copyright": "Copyright © 2026 YG",
    "asar": true,
    "files": [
      "app.js",
      "template.html",
      "lunar.min.js",
      "build.js",
      "preload.js",
      "electron-main.js",
      "holidays.js",
      "holiday-store.js",
      "holidayupd.html",
      "calendar.html",
      "reminder.html",
      "remindlist.html",
      "dock.html",
      "exit.html",
      "settings.html",
      "icon.ico",
      "README.md",
      "使用说明.html",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "简洁桌面日历",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "runAfterFinish": true,
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
